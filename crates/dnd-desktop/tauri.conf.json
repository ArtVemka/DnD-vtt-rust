{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DnD Table",
  "version": "0.1.0",
  "identifier": "ru.dndstol.app",
  "build": {
    "frontendDist": "../../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../renderer/": "renderer/"
    }
  }
}
